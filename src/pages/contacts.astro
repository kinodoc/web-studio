---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFrame from '../components/SiteFrame.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Контакты — обсудить сайт | Веб-студия" description="Расскажите о задаче и получите понятный следующий шаг: формат сайта, примерный объём работ и что потребуется для старта." canonical="https://kinodoc.github.io/web-studio/contacts/">
<SiteFrame active="contacts"><main id="top" class="inner-page section-shell contacts-page">
<div class="page-hero" data-reveal><div class="section-kicker">[ КОНТАКТЫ / 01 ]</div><p class="page-overline">Любой большой проект начинается с разговора</p><h1>Расскажите,<br />что хотите <em>создать.</em></h1><p class="page-lead">Не обязательно приходить с готовым техническим заданием. Достаточно описать идею, бизнес и то, что сайт должен изменить. Поможем определить подходящий формат и следующий шаг.</p></div>
<div class="contact-methods"><article><span class="section-kicker">[ 01 — ИДЕЯ ]</span><h2>Что хотите получить?</h2><p>Новый сайт, обновление старого, отдельную посадочную страницу или необычный интерактивный проект — опишите, что сейчас нужно бизнесу.</p></article><article><span class="section-kicker">[ 02 — ФОРМАТ ]</span><h2>Что уже известно?</h2><p>Можно приложить ссылку на текущий сайт, примеры, список услуг или просто набросать мысли. Материалы необязательно должны быть идеальными.</p></article><article><span class="section-kicker">[ 03 — СЛЕДУЮЩИЙ ШАГ ]</span><h2>Согласуем план</h2><p>После обсуждения определим объём работ, ориентир по стоимости и сроки. Начинаем только после согласования условий.</p></article></div>
<section class="contact-panel" id="contact-form">
<div class="section-kicker">[ НАПИСАТЬ НАМ ]</div>
<h2>Давайте начнём<br /><em>с вашей идеи.</em></h2>
<p>Заполните форму — сообщение придёт на нашу электронную почту.</p>
<form class="inquiry-form" id="inquiry-form" action="https://formsubmit.co/ajax/79994528383@mail.ru" method="POST">
<input type="hidden" name="_subject" value="Новая заявка с сайта Веб-студия" />
<input type="hidden" name="_template" value="table" />
<div class="form-field"><label for="inquiry-name">Как к вам обращаться <span>*</span></label><input id="inquiry-name" name="name" type="text" autocomplete="name" maxlength="100" required placeholder="Ваше имя" /></div>
<div class="form-field"><label for="inquiry-contact">Телефон или другой способ связи <span>*</span></label><input id="inquiry-contact" name="contact" type="text" autocomplete="tel" maxlength="160" required placeholder="Телефон, мессенджер или почта" /></div>
<div class="form-field"><label for="inquiry-email">Электронная почта <span class="field-optional">(необязательно)</span></label><input id="inquiry-email" name="email" type="email" autocomplete="email" maxlength="160" placeholder="адрес@почта.рф" /></div>
<div class="form-field message-field"><label for="inquiry-message">Расскажите о проекте <span>*</span></label><textarea id="inquiry-message" name="message" rows="5" maxlength="5000" required placeholder="Какой сайт нужен и чем он должен помочь?"></textarea><div class="speech-controls"><button class="speech-toggle" id="speech-toggle" type="button" aria-pressed="false" aria-describedby="speech-help"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2.5" width="6" height="12" rx="3"></rect><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5M8.5 21.5h7"></path></svg><span id="speech-button-label">Начать запись</span></button><span class="speech-indicator" id="speech-indicator" aria-hidden="true"></span><p class="speech-help" id="speech-help">Нажмите кнопку и говорите по-русски. Распознанный текст появится в поле — его можно отредактировать. Для распознавания браузер может использовать внешний сервис.</p></div></div>
<div class="form-honeypot" aria-hidden="true"><label for="inquiry-company">Не заполняйте это поле</label><input id="inquiry-company" name="_honey" type="text" tabindex="-1" autocomplete="off" /></div>
<label class="form-consent"><input type="checkbox" name="consent" value="yes" required /><span>Согласен(на) на обработку указанных данных для связи по моей заявке.</span></label>
<button class="form-submit" id="inquiry-submit" type="submit">Отправить заявку <span>↗</span></button>
<p class="form-status" id="inquiry-status" role="status" aria-live="polite"></p>

</form>
</section>
<section class="page-end"><p>Пока выбираете формат?</p><a class="underlined-link" href={base + 'services/'}>Посмотреть услуги и цены <span>↗</span></a></section>
<script>
const form = document.querySelector('#inquiry-form');
const status = document.querySelector('#inquiry-status');
const submit = document.querySelector('#inquiry-submit');
if (form instanceof HTMLFormElement && status instanceof HTMLElement && submit instanceof HTMLButtonElement) {
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    status.textContent = 'Отправляем заявку…';
    status.className = 'form-status is-pending';
    submit.disabled = true;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }
      });
      const result = await response.json();
      if (!response.ok || result.success !== 'true' && result.success !== true) {
        throw new Error('Submission failed');
      }
      form.reset();
      status.textContent = 'Заявка отправлена. Спасибо! Мы свяжемся с вами по указанным контактам.';
      status.className = 'form-status is-success';
    } catch {
      status.textContent = 'Не удалось отправить заявку. Попробуйте ещё раз позже или напишите на 79994528383@mail.ru.';
      status.className = 'form-status is-error';
    } finally {
      submit.disabled = false;
    }
  });
}

const messageField = document.querySelector<HTMLTextAreaElement>('#inquiry-message');
const speechButton = document.querySelector<HTMLButtonElement>('#speech-toggle');
const speechButtonLabel = document.querySelector<HTMLElement>('#speech-button-label');
const speechIndicator = document.querySelector<HTMLElement>('#speech-indicator');
const speechHelp = document.querySelector<HTMLElement>('#speech-help');

if (messageField && speechButton && speechButtonLabel && speechIndicator && speechHelp) {
  const mediaDevices = navigator.mediaDevices;
  const canRecord = Boolean(mediaDevices?.getUserMedia) && 'MediaRecorder' in window;

  if (!canRecord) {
    speechButton.disabled = true;
    speechButtonLabel.textContent = 'Запись недоступна';
    speechHelp.textContent = 'Этот браузер не поддерживает запись звука на сайте. Можно ввести текст вручную или использовать микрофон клавиатуры телефона.';
  } else {
    let stream: MediaStream | null = null;
    let recorder: MediaRecorder | null = null;
    let chunks: BlobPart[] = [];
    let isRecording = false;

    const setRecordingState = (recording: boolean) => {
      isRecording = recording;
      speechButton.setAttribute('aria-pressed', String(recording));
      speechButton.classList.toggle('is-listening', recording);
      speechIndicator.classList.toggle('is-active', recording);
      speechButtonLabel.textContent = recording ? 'Остановить запись' : 'Начать запись';
    };

    const releaseMicrophone = () => {
      stream?.getTracks().forEach((track) => track.stop());
      stream = null;
    };

    speechButton.addEventListener('click', async () => {
      if (isRecording) {
        recorder?.stop();
        return;
      }

      speechHelp.textContent = 'Запрашиваем доступ к микрофону…';
      speechButton.disabled = true;
      try {
        stream = await mediaDevices.getUserMedia({ audio: true });
        chunks = [];
        const options = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
          ? { mimeType: 'audio/webm;codecs=opus' }
          : undefined;
        recorder = new MediaRecorder(stream, options);
        recorder.addEventListener('dataavailable', (event) => {
          if (event.data.size > 0) chunks.push(event.data);
        });
        recorder.addEventListener('error', () => {
          speechHelp.textContent = 'Не удалось записать звук. Проверьте разрешение на микрофон и попробуйте ещё раз.';
          setRecordingState(false);
          releaseMicrophone();
          speechButton.disabled = false;
        });
        recorder.addEventListener('stop', () => {
          const recording = new Blob(chunks, { type: recorder?.mimeType || 'audio/webm' });
          releaseMicrophone();
          setRecordingState(false);
          speechButton.disabled = false;
          if (recording.size === 0) {
            speechHelp.textContent = 'Запись пустая. Нажмите «Начать запись» и попробуйте ещё раз.';
            return;
          }
          speechHelp.textContent = 'Запись завершена. Браузер сохранил звук, но не преобразовал его в текст. Пока можно использовать микрофон клавиатуры телефона или ввести текст вручную.';
        });
        recorder.start();
        setRecordingState(true);
        speechHelp.textContent = 'Идёт запись. Говорите и делайте паузы сколько нужно. Когда закончите, нажмите «Остановить запись». Звук не отправляется с формой.';
      } catch {
        releaseMicrophone();
        setRecordingState(false);
        speechHelp.textContent = 'Не удалось включить микрофон. Разрешите доступ в браузере или введите текст вручную.';
      } finally {
        speechButton.disabled = false;
      }
    });

    window.addEventListener('pagehide', () => {
      if (recorder?.state === 'recording') recorder.stop();
      releaseMicrophone();
    });
  }
}
</script>
<style>
.message-field textarea { display:block; width:100%; }
.speech-controls { display:flex; flex-wrap:wrap; align-items:center; gap:10px 12px; margin-top:11px; }
.speech-toggle { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:42px; padding:10px 15px; border:1px solid rgba(217,255,67,.38); border-radius:999px; background:rgba(217,255,67,.06); color:var(--text); font:600 11px/1.4 var(--body); cursor:pointer; transition:background .2s,border-color .2s,transform .2s; }
.speech-toggle svg { width:17px; height:17px; fill:none; stroke:var(--acid); stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
.speech-toggle:hover:not(:disabled) { background:rgba(217,255,67,.13); border-color:var(--acid); transform:translateY(-1px); }
.speech-toggle:focus-visible { outline:2px solid var(--acid); outline-offset:3px; }
.speech-toggle:disabled { opacity:.58; cursor:not-allowed; }
.speech-toggle.is-listening { background:var(--acid); border-color:var(--acid); color:#090a0b; }
.speech-toggle.is-listening svg { stroke:#090a0b; }
.speech-indicator { display:none; width:8px; height:8px; border-radius:50%; background:#ff6b62; }
.speech-indicator.is-active { display:inline-block; animation:speech-pulse 1.2s ease-in-out infinite; }
.speech-help { flex-basis:100%; margin:0; color:var(--muted); font-size:11px; line-height:1.7; }
@keyframes speech-pulse { 50% { opacity:.35; transform:scale(.8); } }
@media (prefers-reduced-motion: reduce) { .speech-indicator.is-active { animation:none; } }
</style>
</main></SiteFrame></BaseLayout>