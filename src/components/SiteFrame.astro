---
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Главная', href: base, key: 'home' },
  { label: 'Услуги', href: base + 'services/', key: 'services' },
  { label: 'Лендинги', href: base + 'services/landing/', key: 'landing' },
  { label: 'Сайты-визитки', href: base + 'services/business-card/', key: 'business-card' },
  { label: 'Корпоративные сайты', href: base + 'services/corporate/', key: 'corporate' },
  { label: 'Индивидуальная разработка', href: base + 'services/custom/', key: 'custom' },
  { label: 'Контакты', href: base + 'contacts/', key: 'contacts' },
];
---
<header class="site-header">
  <a class="brand" href={base} aria-label="Веб-студия — главная">
    <span class="brand-mark">W<span>·</span></span>
    <span class="brand-name">WEB STUDIO<span>ЦИФРОВЫЕ МИРЫ · ПРОДУКТЫ</span></span>
  </a>
  <button class="menu-toggle" data-menu-toggle aria-controls="site-navigation" aria-expanded="false" aria-label="Открыть меню"><span></span><span></span></button>
  <nav class="nav" id="site-navigation" data-menu aria-label="Главная навигация">
    {links.map((link) => <a class:list={[{ 'nav-current': active === link.key }]} href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
    <a class="nav-cta" href={base + 'contacts/'}>Рассказать об идее <span>↗</span></a>
  </nav>
</header>
<slot />
<footer class="footer section-shell">
  <a class="brand" href={base} aria-label="Веб-студия — главная"><span class="brand-mark">W<span>·</span></span><span class="brand-name">WEB STUDIO<span>ЦИФРОВЫЕ МИРЫ · ПРОДУКТЫ</span></span></a>
  <p>Создаём цифровые продукты и вселенные для людей.</p>
  <span>© <span data-year>2026</span> Веб-студия</span>
  <a href="#top" class="back-top">Наверх ↑</a>
</footer>