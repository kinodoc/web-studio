---
const apiUrl = (import.meta.env.PUBLIC_CHAT_API_URL || '').replace(/\/$/, '');
---
<div class="ws-chat" data-ws-chat data-api={apiUrl} data-base={import.meta.env.BASE_URL}>
  <button class="ws-chat-launcher" type="button" data-chat-open aria-controls="ws-chat-panel" aria-expanded="false">
    <span class="ws-chat-launcher-mark" aria-hidden="true">↗</span>
    <span class="ws-chat-launcher-copy"><strong>Есть идея для сайта?</strong><small>Давайте обсудим</small></span>
    <span class="ws-chat-launcher-dot" aria-hidden="true"></span>
  </button>

  <section class="ws-chat-panel" id="ws-chat-panel" aria-label="Чат веб-студии" aria-hidden="true">
    <header class="ws-chat-head">
      <div class="ws-chat-identity"><span class="ws-chat-brand">W<span>·</span></span><div><strong>Обсудим вашу идею</strong><small><i></i> WEB STUDIO · САЙТЫ</small></div></div>
      <div class="ws-chat-head-actions">
        <button type="button" data-chat-transfer-toggle aria-expanded="false" aria-label="Перенести переписку" title="Перенести переписку">⇄</button>
        <button type="button" data-chat-expand aria-label="Развернуть чат" title="Развернуть чат">⤢</button>
        <button type="button" data-chat-close aria-label="Свернуть чат" title="Свернуть чат">×</button>
      </div>
    </header>
    <section class="ws-chat-transfer" data-chat-transfer-tools hidden aria-label="Перенос переписки">
      <div class="ws-chat-transfer-block"><strong>Продолжить на другом устройстве</strong><p>Создайте одноразовый код здесь, затем введите его на втором устройстве. Код действует 5 минут.</p><button type="button" data-transfer-create>Получить код переноса</button><output data-transfer-output aria-live="polite"></output></div>
      <div class="ws-chat-transfer-block"><label for="ws-chat-transfer-code">Уже есть код?</label><div class="ws-chat-transfer-claim"><input id="ws-chat-transfer-code" data-transfer-code inputmode="numeric" autocomplete="one-time-code" maxlength="3" placeholder="000" /><button type="button" data-transfer-claim>Продолжить</button></div></div>
      <p class="ws-chat-transfer-status" data-transfer-status role="status" aria-live="polite"></p>
    </section>
    <div class="ws-chat-messages" data-chat-messages aria-live="polite">
      <div class="ws-chat-welcome" data-chat-welcome>
        <span class="ws-chat-kicker">ВАША ИДЕЯ — НАЧАЛО</span>
        <h2>Какой сайт<br /><em>задумали?</em></h2>
        <p>Расскажите, что хотите создать. Можно начать с пары слов — разберёмся вместе.</p>
        <div class="ws-chat-choices" data-chat-choices>
          <button type="button" data-chat-choice="Сайт-визитка">Сайт-визитка <span>↗</span></button>
          <button type="button" data-chat-choice="Одностраничный сайт">Одностраничный сайт <span>↗</span></button>
          <button type="button" data-chat-choice="Небольшой многостраничный сайт">Многостраничный сайт <span>↗</span></button>
          <button type="button" data-chat-choice="Портал">Портал <span>↗</span></button>
        </div>
      </div>
    </div>
    <p class="ws-chat-status" data-chat-status role="status" aria-live="polite"></p>
    <form class="ws-chat-compose" data-chat-form>
      <label class="ws-chat-sr-only" for="ws-chat-input">Ваше сообщение</label>
      <textarea id="ws-chat-input" data-chat-input rows="1" maxlength="5000" placeholder="Опишите вашу идею…" required></textarea>
      <button type="submit" data-chat-send aria-label="Отправить сообщение">↑</button>
      <span class="ws-chat-compose-note">Enter — отправить · Shift + Enter — новая строка</span>
    </form>
  </section>
</div>

<style>
.ws-chat{--chat-ink:#171a22;--chat-muted:#666a77;--chat-accent:#5d59d8;--chat-paper:#f5f3ed;--chat-line:rgba(23,26,34,.15);font-family:Manrope,Onest,system-ui,sans-serif;position:fixed;z-index:1000;right:24px;bottom:24px;color:var(--chat-ink)}
.ws-chat *{box-sizing:border-box}
.ws-chat button,.ws-chat textarea{font:inherit}
.ws-chat-launcher{display:flex;align-items:center;gap:12px;width:min(310px,calc(100vw - 32px));padding:13px 16px;background:var(--chat-ink);color:#f7f6f1;border:1px solid rgba(255,255,255,.12);border-radius:2px;text-align:left;cursor:pointer;box-shadow:7px 7px 0 rgba(93,89,216,.28);transition:transform .18s,box-shadow .18s}
.ws-chat-launcher:hover{transform:translate(-2px,-2px);box-shadow:9px 9px 0 rgba(93,89,216,.3)}
.ws-chat-launcher-mark{display:grid;place-items:center;width:39px;height:39px;flex:0 0 39px;background:var(--chat-accent);font-size:22px}
.ws-chat-launcher-copy{display:grid;gap:3px;flex:1}.ws-chat-launcher-copy strong{font-size:12px;font-weight:700;letter-spacing:-.02em}.ws-chat-launcher-copy small{font-size:10px;color:#bfc0cc}
.ws-chat-launcher-dot{width:7px;height:7px;background:#b8e986;border-radius:50%;box-shadow:0 0 0 4px rgba(184,233,134,.1)}
.ws-chat-panel{display:none;position:fixed;right:24px;bottom:24px;width:min(420px,calc(100vw - 32px));height:min(620px,calc(100dvh - 48px));min-height:400px;background:var(--chat-paper);border:1px solid rgba(23,26,34,.22);box-shadow:12px 12px 0 rgba(93,89,216,.18),0 25px 80px rgba(23,26,34,.22);grid-template-rows:auto auto minmax(0,1fr) auto auto;overflow:hidden}
.ws-chat.is-open .ws-chat-panel{display:grid}.ws-chat.is-open .ws-chat-launcher{display:none}
.ws-chat-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;background:#fff;border-bottom:1px solid var(--chat-line)}
.ws-chat-identity{display:flex;align-items:center;gap:11px;min-width:0}.ws-chat-brand{display:grid;place-items:center;width:38px;height:38px;background:var(--chat-ink);color:#fff;font-size:17px;font-weight:800}.ws-chat-brand span{color:#aaa6ff}
.ws-chat-identity>div{display:grid;gap:5px}.ws-chat-identity strong{font-size:12px;letter-spacing:-.025em}.ws-chat-identity small{display:flex;align-items:center;gap:6px;color:var(--chat-muted);font-size:8px;letter-spacing:.1em}.ws-chat-identity small i{width:5px;height:5px;border-radius:50%;background:var(--chat-accent)}
.ws-chat-head-actions{display:flex;gap:5px}.ws-chat-head-actions button{display:grid;place-items:center;width:31px;height:31px;border:1px solid var(--chat-line);background:transparent;color:var(--chat-ink);font-size:20px;cursor:pointer}.ws-chat-head-actions button:hover{background:#eeecff;border-color:var(--chat-accent)}
.ws-chat-transfer{padding:13px 16px;background:#eeecff;border-bottom:1px solid var(--chat-line);overflow-y:auto;max-height:46%}
.ws-chat-transfer[hidden]{display:none}
.ws-chat-transfer-block{display:grid;gap:7px}.ws-chat-transfer-block+.ws-chat-transfer-block{margin-top:13px;padding-top:12px;border-top:1px solid var(--chat-line)}
.ws-chat-transfer-block strong,.ws-chat-transfer-block label{font-size:11px;font-weight:800}.ws-chat-transfer-block p{margin:0;color:var(--chat-muted);font-size:10px;line-height:1.6}
.ws-chat-transfer-block button{padding:9px 11px;border:0;background:var(--chat-ink);color:#fff;font-size:10px;cursor:pointer}.ws-chat-transfer-block button:disabled{opacity:.5;cursor:wait}
.ws-chat-transfer output{display:block;min-height:0;color:var(--chat-accent);font-size:10px;font-weight:700;letter-spacing:.04em}.ws-chat-transfer output:not(:empty){padding:8px 0}
.ws-chat-transfer-claim{display:grid;grid-template-columns:82px minmax(0,1fr);gap:7px}.ws-chat-transfer-claim input{min-width:0;width:100%;padding:8px;border:1px solid var(--chat-line);background:#fff;color:var(--chat-ink);font-size:18px;letter-spacing:.25em;text-align:center}
.ws-chat-transfer-status{margin:7px 0 0;color:#a13b38;font-size:10px}.ws-chat-transfer-status:empty{display:none}
.ws-chat-messages{overflow-y:auto;overscroll-behavior:contain;padding:23px 20px 18px;scroll-behavior:smooth}
.ws-chat-welcome{max-width:320px}.ws-chat-kicker{color:var(--chat-accent);font-size:8px;letter-spacing:.15em;font-weight:800}.ws-chat-welcome h2{margin:16px 0 10px;font-size:clamp(29px,8vw,39px);font-weight:600;line-height:1.03;letter-spacing:-.08em}.ws-chat-welcome h2 em{color:var(--chat-accent);font-style:normal}.ws-chat-welcome p{max-width:280px;margin:0 0 22px;color:#60636f;font-size:11px;line-height:1.8}
.ws-chat-choices{display:grid;gap:7px}.ws-chat-choices button{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 12px;border:1px solid var(--chat-line);background:rgba(255,255,255,.58);color:var(--chat-ink);text-align:left;font-size:10px;cursor:pointer;transition:border-color .15s,background .15s}.ws-chat-choices button span{color:var(--chat-accent);font-size:14px}.ws-chat-choices button:hover{border-color:var(--chat-accent);background:#eeecff}
.ws-chat-message{max-width:88%;margin:0 0 13px;padding:11px 13px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;line-height:1.65}.ws-chat-message.client{margin-left:auto;background:var(--chat-accent);color:white}.ws-chat-message.admin{margin-right:auto;background:#fff;border:1px solid var(--chat-line);color:var(--chat-ink)}.ws-chat-message time{display:block;margin-top:5px;font-size:8px;opacity:.7}
.ws-chat-status{min-height:0;margin:0;padding:0 18px;color:#a13b38;font-size:10px}.ws-chat-status:not(:empty){padding-top:8px}
.ws-chat-compose{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 38px;gap:9px;padding:12px 14px 25px;border-top:1px solid var(--chat-line);background:#fff}
.ws-chat-compose textarea{width:100%;min-height:42px;max-height:120px;resize:vertical;padding:12px;border:1px solid var(--chat-line);border-radius:0;background:#f8f7f2;color:var(--chat-ink);font-size:11px;line-height:1.5;outline:none}.ws-chat-compose textarea:focus{border-color:var(--chat-accent)}.ws-chat-compose textarea::placeholder{color:#898b95}
.ws-chat-compose>button{align-self:stretch;border:0;background:var(--chat-accent);color:white;font-size:21px;cursor:pointer}.ws-chat-compose>button:disabled{opacity:.45;cursor:wait}
.ws-chat-compose-note{position:absolute;left:15px;bottom:8px;color:#858793;font-size:8px}
.ws-chat.is-expanded .ws-chat-panel{inset:3vh 3vw;width:94vw;height:94dvh;max-height:none;min-height:0;right:auto;bottom:auto;box-shadow:0 24px 100px rgba(23,26,34,.3)}
.ws-chat.is-expanded .ws-chat-messages{padding:clamp(24px,5vw,56px) clamp(18px,7vw,90px)}.ws-chat.is-expanded .ws-chat-welcome{max-width:520px}.ws-chat.is-expanded .ws-chat-welcome h2{font-size:clamp(38px,5vw,64px)}.ws-chat.is-expanded .ws-chat-welcome p{font-size:13px;max-width:440px}.ws-chat.is-expanded .ws-chat-choices{max-width:420px;grid-template-columns:1fr 1fr}.ws-chat.is-expanded .ws-chat-message{font-size:13px;max-width:72%;padding:14px 17px}.ws-chat.is-expanded .ws-chat-compose{padding:18px clamp(18px,7vw,90px) 32px;grid-template-columns:minmax(0,1fr) 48px}.ws-chat.is-expanded .ws-chat-compose textarea{font-size:13px;padding:15px;min-height:52px}.ws-chat.is-expanded .ws-chat-compose>button{font-size:25px}.ws-chat.is-expanded .ws-chat-compose-note{left:clamp(18px,7vw,90px);bottom:10px}
.ws-chat-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:600px){.ws-chat{right:12px;bottom:12px}.ws-chat-launcher{width:min(290px,calc(100vw - 24px));padding:11px 13px}.ws-chat-panel{right:0;bottom:0;width:100vw;height:100dvh;min-height:0;border:0;box-shadow:none}.ws-chat.is-expanded .ws-chat-panel{inset:0;width:100vw;height:100dvh}.ws-chat-head{padding:13px 15px}.ws-chat-messages{padding:20px 16px}.ws-chat-compose{padding:10px 12px 25px}.ws-chat-compose-note{left:13px}.ws-chat.is-expanded .ws-chat-messages{padding:25px 16px}.ws-chat.is-expanded .ws-chat-choices{grid-template-columns:1fr}.ws-chat.is-expanded .ws-chat-message{max-width:88%;font-size:12px}.ws-chat.is-expanded .ws-chat-compose{padding:10px 12px 25px}.ws-chat.is-expanded .ws-chat-compose-note{left:13px}}
@media(prefers-reduced-motion:reduce){.ws-chat-launcher,.ws-chat-choices button{transition:none}}
</style>

<script>
const root = document.querySelector('[data-ws-chat]');
if (root instanceof HTMLElement && !root.dataset.initialized) {
  root.dataset.initialized = 'true';
  const api = (root.dataset.api || '').replace(/\/$/, '');
  const panel = root.querySelector('.ws-chat-panel');
  const opener = root.querySelector('[data-chat-open]');
  const closer = root.querySelector('[data-chat-close]');
  const expand = root.querySelector('[data-chat-expand]');
  const form = root.querySelector('[data-chat-form]');
  const input = root.querySelector('[data-chat-input]');
  const messages = root.querySelector('[data-chat-messages]');
  const status = root.querySelector('[data-chat-status]');
  const send = root.querySelector('[data-chat-send]');
  const welcome = root.querySelector('[data-chat-welcome]');
  const choices = root.querySelector('[data-chat-choices]');
  const transferToggle = root.querySelector('[data-chat-transfer-toggle]');
  const transferTools = root.querySelector('[data-chat-transfer-tools]');
  const transferCreate = root.querySelector('[data-transfer-create]');
  const transferOutput = root.querySelector('[data-transfer-output]');
  const transferCode = root.querySelector('[data-transfer-code]');
  const transferClaim = root.querySelector('[data-transfer-claim]');
  const transferStatus = root.querySelector('[data-transfer-status]');
  const tokenKey = 'webStudioChatTokenV1';
  const conversationKey = 'webStudioChatConversationV1';
  let token = localStorage.getItem(tokenKey) || '';
  if (!token) {
    const bytes = crypto.getRandomValues(new Uint8Array(32));
    token = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
    localStorage.setItem(tokenKey, token);
  }
  let conversationId = localStorage.getItem(conversationKey) || '';
  let polling = null;
  let sending = false;
  const setStatus = (message = '') => { if (status) status.textContent = message; };
  const openPanel = () => {
    root.classList.add('is-open');
    panel?.setAttribute('aria-hidden', 'false');
    opener?.setAttribute('aria-expanded', 'true');
    if (!api) {
      setStatus('Чат подключается. Пока можно написать нам через раздел «Контакты».');
      if (send instanceof HTMLButtonElement) send.disabled = true;
    } else {
      setStatus('');
      if (conversationId) ensureConversation().then(loadMessages).catch(() => setStatus('Не удалось подключиться. Проверьте интернет и попробуйте ещё раз.'));
      startPolling();
    }
    window.setTimeout(() => input instanceof HTMLTextAreaElement && input.focus(), 60);
  };
  const closePanel = () => {
    root.classList.remove('is-open', 'is-expanded');
    panel?.setAttribute('aria-hidden', 'true');
    opener?.setAttribute('aria-expanded', 'false');
    expand?.setAttribute('aria-label', 'Развернуть чат');
    if (polling) window.clearInterval(polling);
    polling = null;
  };
  const request = async (path, options = {}) => {
    const response = await fetch(api + path, { ...options, headers: { 'Content-Type': 'application/json', ...(options.headers || {}) } });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(result.error || 'Request failed');
    return result;
  };
  async function ensureConversation() {
    if (!api) throw new Error('Chat API is not configured');
    const result = await request('/api/client/start', { method: 'POST', body: JSON.stringify({ token }) });
    conversationId = result.conversationId;
    localStorage.setItem(conversationKey, conversationId);
  }
  function render(items) {
    if (!(messages instanceof HTMLElement)) return;
    const previousWelcome = messages.querySelector('[data-chat-welcome]');
    if (previousWelcome && items.length) previousWelcome.remove();
    const existing = new Set(Array.from(messages.querySelectorAll('[data-message-id]')).map((node) => node.getAttribute('data-message-id')));
    for (const item of items) {
      if (existing.has(item.id)) continue;
      const bubble = document.createElement('article');
      bubble.className = 'ws-chat-message ' + (item.sender === 'admin' ? 'admin' : 'client');
      bubble.dataset.messageId = item.id;
      const body = document.createElement('div');
      body.textContent = item.body;
      const time = document.createElement('time');
      const date = new Date(item.createdAt);
      time.dateTime = date.toISOString();
      time.textContent = date.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
      bubble.append(body, time);
      messages.append(bubble);
    }
    messages.scrollTop = messages.scrollHeight;
  }
  async function loadMessages() {
    if (!api || !conversationId) return;
    const result = await request('/api/client/messages?token=' + encodeURIComponent(token) + '&conversationId=' + encodeURIComponent(conversationId));
    render(result.messages || []);
  }
  function startPolling() {
    if (polling || !api) return;
    polling = window.setInterval(() => loadMessages().catch(() => {}), 5000);
  }
  async function sendMessage(message) {
    if (!api || sending) return;
    sending = true;
    if (send instanceof HTMLButtonElement) send.disabled = true;
    setStatus('');
    try {
      if (!conversationId) await ensureConversation();
      await request('/api/client/messages', { method: 'POST', body: JSON.stringify({ token, conversationId, message }) });
      if (input instanceof HTMLTextAreaElement) input.value = '';
      if (welcome instanceof HTMLElement) welcome.remove();
      await loadMessages();
      if (expand instanceof HTMLButtonElement) expand.hidden = false;
      input instanceof HTMLTextAreaElement && input.focus();
    } catch {
      setStatus('Сообщение не отправлено. Текст остался в поле — попробуйте ещё раз.');
      if (input instanceof HTMLTextAreaElement) input.value = message;
    } finally {
      sending = false;
      if (send instanceof HTMLButtonElement) send.disabled = false;
    }
  }
  transferToggle?.addEventListener('click', () => {
    if (!(transferTools instanceof HTMLElement)) return;
    const shown = transferTools.hidden;
    transferTools.hidden = !shown;
    transferToggle.setAttribute('aria-expanded', String(shown));
    if (shown && !api && transferStatus instanceof HTMLElement) transferStatus.textContent = 'Перенос станет доступен после подключения чата.';
  });
  transferCreate?.addEventListener('click', async () => {
    if (!api || !(transferCreate instanceof HTMLButtonElement)) return;
    transferCreate.disabled = true;
    if (transferOutput instanceof HTMLOutputElement) transferOutput.textContent = 'Создаём код…';
    if (transferStatus instanceof HTMLElement) transferStatus.textContent = '';
    try {
      await ensureConversation();
      const result = await request('/api/client/transfer/create', { method: 'POST', body: JSON.stringify({ token, conversationId }) });
      if (transferOutput instanceof HTMLOutputElement) transferOutput.textContent = 'Ваш код: ' + result.code + ' · действует 5 минут';
    } catch (error) {
      if (transferOutput instanceof HTMLOutputElement) transferOutput.textContent = '';
      if (transferStatus instanceof HTMLElement) transferStatus.textContent = error instanceof Error ? error.message : 'Не удалось создать код.';
    } finally {
      transferCreate.disabled = false;
    }
  });
  transferClaim?.addEventListener('click', async () => {
    if (!api || !(transferClaim instanceof HTMLButtonElement) || !(transferCode instanceof HTMLInputElement)) return;
    const code = transferCode.value.trim();
    if (!/^\d{3}$/.test(code)) {
      if (transferStatus instanceof HTMLElement) transferStatus.textContent = 'Введите ровно три цифры.';
      return;
    }
    transferClaim.disabled = true;
    if (transferStatus instanceof HTMLElement) transferStatus.textContent = 'Восстанавливаем переписку…';
    try {
      const bytes = crypto.getRandomValues(new Uint8Array(32));
      const nextToken = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
      const result = await request('/api/client/transfer/claim', { method: 'POST', body: JSON.stringify({ code, token: nextToken }) });
      token = nextToken;
      localStorage.setItem(tokenKey, token);
      conversationId = result.conversationId;
      localStorage.setItem(conversationKey, conversationId);
      transferCode.value = '';
      if (transferTools instanceof HTMLElement) transferTools.hidden = true;
      transferToggle?.setAttribute('aria-expanded', 'false');
      if (welcome instanceof HTMLElement) welcome.remove();
      if (transferStatus instanceof HTMLElement) transferStatus.textContent = '';
      setStatus('Переписка восстановлена на этом устройстве.');
      await loadMessages();
      startPolling();
    } catch (error) {
      if (transferStatus instanceof HTMLElement) transferStatus.textContent = error instanceof Error ? error.message : 'Не удалось восстановить переписку.';
    } finally {
      transferClaim.disabled = false;
    }
  });
  transferCode?.addEventListener('input', () => {
    if (transferCode instanceof HTMLInputElement) transferCode.value = transferCode.value.replace(/\D/g, '').slice(0, 3);
  });
  opener?.addEventListener('click', openPanel);
  closer?.addEventListener('click', closePanel);
  expand?.addEventListener('click', () => {
    const expanded = root.classList.toggle('is-expanded');
    expand.setAttribute('aria-label', expanded ? 'Уменьшить чат' : 'Развернуть чат');
    expand.title = expanded ? 'Уменьшить чат' : 'Развернуть чат';
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLTextAreaElement)) return;
    const value = input.value.trim();
    if (value) sendMessage(value);
  });
  choices?.querySelectorAll('[data-chat-choice]').forEach((button) => button.addEventListener('click', () => {
    if (input instanceof HTMLTextAreaElement) {
      input.value = 'Хочу обсудить: ' + button.getAttribute('data-chat-choice') + '. ';
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }
  }));
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && root.classList.contains('is-open')) closePanel(); });
}
</script>
